{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentui-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": false },
  "vars": {
    "REGISTRY_URL": "https://www.agentui.pro",
    "PRO_REGISTRY_URL": "https://pro.agentui.pro"
  },
  "durable_objects": {
    "bindings": [{ "name": "AgentUiMcp", "class_name": "AgentUiMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentUiMcp"] }],
  // Custom domain. Requires agentui.pro's zone on Cloudflare; wrangler provisions
  // the mcp.agentui.pro DNS record on deploy.
  "routes": [{ "pattern": "mcp.agentui.pro", "custom_domain": true }]
}
